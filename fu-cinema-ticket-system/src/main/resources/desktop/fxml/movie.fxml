<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.cinema.desktop.controller.MovieController"
      styleClass="page" spacing="12">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="DANH SÁCH PHIM" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblCount" style="-fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
        <Button fx:id="btnAdd" text="+ Thêm phim" styleClass="primary" onAction="#onAdd"/>
        <Button fx:id="btnEdit" text="Sửa" onAction="#onEdit"/>
        <Button fx:id="btnDelete" text="Xoá" onAction="#onDelete"
                style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Bộ lọc tìm kiếm -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="tfSearch" promptText="Tìm theo tên phim..." prefWidth="240"/>
        <ComboBox fx:id="cbGenre" prefWidth="180" promptText="Tất cả thể loại"/>
        <ComboBox fx:id="cbStatus" prefWidth="170" promptText="Tất cả trạng thái"/>
        <ComboBox fx:id="cbSort" prefWidth="170"/>
    </HBox>

    <!-- Bảng danh sách phim -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitle" text="Tên phim" prefWidth="260"/>
            <TableColumn fx:id="colGenre" text="Thể loại" prefWidth="140"/>
            <TableColumn fx:id="colDuration" text="Thời lượng" prefWidth="110"/>
            <TableColumn fx:id="colRelease" text="Khởi chiếu" prefWidth="120"/>
            <TableColumn fx:id="colAge" text="Độ tuổi" prefWidth="90"/>
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="130"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Phân trang -->
    <HBox alignment="CENTER">
        <Pagination fx:id="pagination" maxPageIndicatorCount="7"/>
    </HBox>
</VBox>