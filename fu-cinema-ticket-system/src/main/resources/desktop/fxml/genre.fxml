<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.cinema.desktop.controller.GenreController"
      styleClass="page" spacing="16">

    <Label text="QUẢN LÝ THỂ LOẠI PHIM" styleClass="page-title"/>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- Bảng danh sách thể loại -->
        <TableView fx:id="table" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" text="Tên thể loại" prefWidth="180"/>
                <TableColumn fx:id="colDesc" text="Mô tả" prefWidth="360"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Form nhập liệu bên phải -->
        <VBox fx:id="formBox" spacing="12" prefWidth="340" minWidth="300"
              style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 6; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
            <Label text="Thông tin thể loại" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
            <Separator/>

            <VBox spacing="4">
                <Label text="Tên thể loại (*):"/>
                <TextField fx:id="tfName" promptText="Nhập tên thể loại"/>
            </VBox>

            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Label text="Mô tả (*):"/>
                <TextArea fx:id="taDesc" promptText="Nhập mô tả thể loại..."
                          prefRowCount="6" wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>

            <HBox spacing="8" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                <Button text="Làm mới" onAction="#onNew"/>
                <Button fx:id="btnDelete" text="Xoá" onAction="#onDelete"
                        style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-weight: bold;"/>
                <Button fx:id="btnSave" text="Lưu" onAction="#onSave" styleClass="primary"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
