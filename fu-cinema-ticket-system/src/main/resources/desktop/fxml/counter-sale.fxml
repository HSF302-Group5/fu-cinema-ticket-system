<?xml version="1.0" encoding="UTF-8"?>

<?import com.fu.cinema.desktop.component.SeatMapView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fu.cinema.desktop.controller.CounterSaleController"
            styleClass="page">

    <!-- Cột bên trái: Thao tác chọn thông tin đặt vé -->
    <left>
        <VBox spacing="10" prefWidth="350" style="-fx-padding: 0 16 0 0;">
            <Label text="Bán vé tại quầy" styleClass="page-title"/>

            <!-- (1) Tìm & Chọn khách hàng -->
            <Label text="Khách hàng thành viên:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="tfCustomer" promptText="Tìm theo Tên, SĐT, Email..."/>
            <ListView fx:id="lvCustomers" prefHeight="130"/>

            <Separator/>

            <!-- (2) Chọn Phim & Suất chiếu -->
            <Label text="Phim:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cbMovie" promptText="-- Chọn phim --" maxWidth="Infinity"/>

            <Label text="Suất chiếu:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cbShowtime" promptText="-- Chọn suất chiếu --" maxWidth="Infinity"/>

            <Separator/>

            <!-- (3) Trạng thái ghế & Tiền thanh toán -->
            <Label fx:id="lblSeats" text="Ghế đang chọn: (Chưa chọn)" wrapText="true"
                   style="-fx-font-size: 13px; -fx-text-fill: #1f2937;"/>
            <Label fx:id="lblTotal" text="Tổng tiền: 0 đ"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e50914;"/>

            <CheckBox fx:id="chkPaid" text="Đã thanh toán (CONFIRMED)" selected="true"
                      style="-fx-font-weight: bold; -fx-text-fill: #15803d;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- (4) Nút Bán vé -->
            <Button fx:id="btnSell" text="Bán vé" maxWidth="Infinity" styleClass="primary" onAction="#onSell"
                    style="-fx-font-size: 14px; -fx-padding: 10;"/>
        </VBox>
    </left>

    <!-- Khu vực trung tâm: Sơ đồ ghế SeatMapView -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
            <VBox alignment="CENTER" style="-fx-padding: 10;">
                <SeatMapView fx:id="seatMap"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
