<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.cinema.desktop.controller.BookingAdminController"
      styleClass="page" spacing="12">

    <!-- Header: Tiêu đề, số lượng & Nút thao tác -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Quản lý đơn đặt vé" styleClass="page-title"/>
        <Label fx:id="lblCount" style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnConfirm" text="Xác nhận đơn" styleClass="primary" onAction="#onConfirm"/>
        <Button fx:id="btnCancel" text="Huỷ đơn" onAction="#onCancel"/>
    </HBox>

    <!-- Toolbar: Bộ lọc tìm kiếm -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <ComboBox fx:id="cbStatus" promptText="Trạng thái" prefWidth="130"/>
        <DatePicker fx:id="dpFrom" promptText="Từ ngày" prefWidth="130"/>
        <DatePicker fx:id="dpTo" promptText="Đến ngày" prefWidth="130"/>
        <TextField fx:id="tfKeyword" promptText="Khách hàng / SĐT / Email..." prefWidth="240"/>
        <Button text="Lọc" onAction="#onSearch"/>
        <Button text="Làm mới" onAction="#onReset"/>
    </HBox>

    <!-- Bảng danh sách đơn đặt vé -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="Mã đơn" prefWidth="75"/>
            <TableColumn fx:id="colCustomer" text="Khách hàng" prefWidth="160"/>
            <TableColumn fx:id="colMovie" text="Phim" prefWidth="180"/>
            <TableColumn fx:id="colRoom" text="Phòng" prefWidth="90"/>
            <TableColumn fx:id="colStartTime" text="Giờ chiếu" prefWidth="130"/>
            <TableColumn fx:id="colSeatCount" text="Số vé" prefWidth="65"/>
            <TableColumn fx:id="colTotal" text="Tổng tiền" prefWidth="110"/>
            <TableColumn fx:id="colBookingDate" text="Ngày đặt" prefWidth="130"/>
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Phân trang -->
    <HBox alignment="CENTER">
        <Pagination fx:id="pagination" maxPageIndicatorCount="7"/>
    </HBox>
</VBox>

