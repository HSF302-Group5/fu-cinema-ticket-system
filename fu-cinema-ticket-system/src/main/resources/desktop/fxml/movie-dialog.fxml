<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.fu.cinema.desktop.controller.MovieDialogController"
          hgap="12" vgap="12" prefWidth="520" style="-fx-padding: 16;">

    <columnConstraints>
        <ColumnConstraints minWidth="130" prefWidth="130"/>
        <ColumnConstraints hgrow="ALWAYS" minWidth="320"/>
    </columnConstraints>

    <Label text="Tên phim (*):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="tfTitle" promptText="Nhập tên phim" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Đạo diễn (*):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="tfDirector" promptText="Nhập tên đạo diễn" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Thời lượng (phút) (*):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <Spinner fx:id="spDuration" editable="true" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Khởi chiếu (*):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <DatePicker fx:id="dpRelease" promptText="Chọn ngày khởi chiếu" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Label text="Độ tuổi (*):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <ComboBox fx:id="cbAgeRating" promptText="Chọn độ tuổi" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <Label text="Thể loại (*):" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <ComboBox fx:id="cbGenre" promptText="Chọn thể loại" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    <Label text="Trạng thái (*):" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
    <ComboBox fx:id="cbStatus" promptText="Chọn trạng thái" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

    <Label text="Poster URL (*):" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
    <TextField fx:id="tfPoster" promptText="https://..." GridPane.rowIndex="7" GridPane.columnIndex="1"/>

    <Label text="Mô tả (*):" GridPane.rowIndex="8" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
    <TextArea fx:id="taDescription" promptText="Nhập mô tả phim..." prefRowCount="4" wrapText="true"
              GridPane.rowIndex="8" GridPane.columnIndex="1"/>
</GridPane>
