<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fu.cinema.desktop.controller.MainController" styleClass="main">
    <left>
        <VBox styleClass="sidebar" spacing="4">
            <Label text="FU CINEMA" styleClass="brand"/>
            <Button fx:id="btnNavDashboard"   text="Dashboard"             onAction="#onDashboard"   maxWidth="Infinity"/>
            <Button fx:id="btnNavCounterSale" text="Bán vé tại quầy"       onAction="#onCounterSale" maxWidth="Infinity"/>
            <Button fx:id="btnNavBooking"     text="Đơn đặt vé"            onAction="#onBooking"     maxWidth="Infinity"/>
            <Separator/>
            <Button fx:id="btnNavGenre"       text="Thể loại"               onAction="#onGenre"       maxWidth="Infinity"/>
            <Button fx:id="btnNavMovie"       text="Phim"                   onAction="#onMovie"       maxWidth="Infinity"/>
            <Button fx:id="btnNavSchedule"    text="Phòng &amp; Suất chiếu" onAction="#onSchedule"   maxWidth="Infinity"/>
            <Button fx:id="btnNavReport"      text="Báo cáo"                onAction="#onReport"      maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Đăng xuất"         onAction="#onLogout"          maxWidth="Infinity"/>
        </VBox>
    </left>
    <bottom>
        <HBox styleClass="status-bar" spacing="16">
            <Label fx:id="lblUser"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblClock"/>
        </HBox>
    </bottom>
</BorderPane>
